{
  "info": {
    "_postman_id": "8a31e84a-9b51-4c28-98e3-4f9e31d871aa",
    "name": "Document Intelligence & Question Extraction API",
    "description": "Complete end-to-end API workflow collection covering authentication, document upload, status monitoring, question extraction, answer matching, human review queue, and group associations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"examiner@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"full_name\": \"Chief Examiner\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Get JWT Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.environment.set(\"token\", jsonData.access_token);",
                  "    console.log(\"Saved JWT access token to environment.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"examiner@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Document Groups",
      "item": [
        {
          "name": "Create Document Group",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.environment.set(\"group_id\", jsonData.id);",
                  "    console.log(\"Saved group_id: \" + jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Senior Secondary Science Exam 2026\",\n  \"description\": \"Question paper and verified official answer key set.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/groups",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups"]
            }
          }
        },
        {
          "name": "Get Group Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/groups/{{group_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "groups", "{{group_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Document Upload & Processing",
      "item": [
        {
          "name": "Upload Question Paper (PDF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.document_id) {",
                  "    pm.environment.set(\"document_id\", jsonData.document_id);",
                  "    console.log(\"Saved document_id: \" + jsonData.document_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_documents/01_digital_exam.pdf"
                },
                {
                  "key": "group_id",
                  "value": "{{group_id}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "upload"]
            }
          }
        },
        {
          "name": "Upload Answer Key (Separate PDF)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_documents/05_answer_key.pdf"
                },
                {
                  "key": "group_id",
                  "value": "{{group_id}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "upload"]
            }
          }
        },
        {
          "name": "Check Document Processing Status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Question & Answer Extraction",
      "item": [
        {
          "name": "Get Document Questions (Paginated & Filtered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.items && jsonData.items.length > 0) {",
                  "    pm.environment.set(\"question_id\", jsonData.items[0].id);",
                  "    console.log(\"Saved question_id: \" + jsonData.items[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/questions?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "questions"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "question_type", "value": "MULTIPLE_CHOICE", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Individual Question Details",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/questions/{{question_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "questions", "{{question_id}}"]
            }
          }
        },
        {
          "name": "Get Document Answer Key Report",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/documents/{{document_id}}/answer-key",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "{{document_id}}", "answer-key"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Human Review Queue",
      "item": [
        {
          "name": "Get Flagged Review Items",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.items && jsonData.items.length > 0) {",
                  "    pm.environment.set(\"review_id\", jsonData.items[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/reviews/flagged?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reviews", "flagged"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "status", "value": "PENDING", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Resolve Review Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"notes\": \"Manually confirmed question options and answer with exam committee.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/reviews/{{review_id}}/resolve",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "reviews", "{{review_id}}", "resolve"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Validation & Error Handling",
      "item": [
        {
          "name": "Invalid File Rejection (Unsupported Type)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample_documents/07_corrupted.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/documents/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "documents", "upload"]
            }
          }
        },
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "System Readiness Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ready",
              "host": ["{{base_url}}"],
              "path": ["ready"]
            }
          }
        }
      ]
    }
  ]
}
