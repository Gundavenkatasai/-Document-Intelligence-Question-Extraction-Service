# ==============================================================================
# Document Intelligence & Question Extraction Service - Environment Configuration
# ==============================================================================

# Application & API
PROJECT_NAME="Document Intelligence & Question Extraction Service"
API_V1_STR="api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL AsyncPG)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/doc_intelligence"
DB_ECHO=false

# Task Queue & Redis
REDIS_URL="redis://localhost:6379/0"

# Storage Configuration ("local" or "s3")
STORAGE_BACKEND="local"
STORAGE_PATH="./data/storage"
# S3_BUCKET="document-intelligence-bucket"
# S3_ENDPOINT_URL="https://s3.amazonaws.com"
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# Document Processing Policies
MAX_UPLOAD_SIZE_MB=50
CONFIDENCE_REVIEW_THRESHOLD=0.75
MIN_CHARS_FOR_NATIVE_TEXT=40

# Multimodal Document Understanding AI Provider ("mock", "gemini", "openai")
AI_PROVIDER="mock"
# AI_API_KEY="your-gemini-or-openai-api-key"
AI_MODEL="gemini-1.5-flash"

# OCR Configuration (Path to tesseract binary if not on PATH)
# TESSERACT_CMD="/usr/bin/tesseract"

# Testing / Local Synchronous Execution Mode
CELERY_TASK_ALWAYS_EAGER=false
